    {
      "title": "HTTP Response Code",
      "description": "Status codes returned by each backend. Stays 200 even during degradation — this is the trap.",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
