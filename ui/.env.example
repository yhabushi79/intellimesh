# Copy to .env and adjust as needed. All values have sensible defaults in config.py.

# --- Ansible / playbook execution ---
# Set this to skip the password prompt in the UI and get true one-click execution.
# ANSIBLE_PASSWORD=

# --- Links shown on the Demo Topology tab ---
# GRAFANA_URL=
# SATELLITE_URL=
# AAP_URL=

# --- UnifAI backend ---
# Override if your MAS route differs from the `unifai` CLI's default.
# UNIFAI_MAS_URL=
# UNIFAI_API_PREFIX=/api
# UNIFAI_SESSION_FILE=~/.unifai/session.json

WORKFLOW_POLL_INTERVAL_SECONDS=3
# Server-side wait before handing off to UI live tracking (seconds). Long workflows
# continue on MAS after this; the UI keeps polling session status until complete.
WORKFLOW_POLL_TIMEOUT_SECONDS=600

# --- Server ---
UI_HOST=0.0.0.0
UI_PORT=5050
UI_DEBUG=false
