# Must match whatever MAS_URL/SSO_URL you used with `unifai auth login`,
# otherwise the cached session cookie won't be valid for this backend and
# every call will 401.
UNIFAI_MAS_URL=http://unifai-multiagent-be-tag-ai--playground2.apps.stc-ai-e1-pp.imap.p1.openshiftapps.com
UNIFAI_API_PREFIX=/api

WORKFLOW_POLL_INTERVAL_SECONDS=3
WORKFLOW_POLL_TIMEOUT_SECONDS=900

UI_HOST=0.0.0.0
UI_PORT=5050
UI_DEBUG=false

# Pre-set so the UI password prompt is hidden and playbooks run with one click.
ANSIBLE_PASSWORD='Mc10vin!!'
